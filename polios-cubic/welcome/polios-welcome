LANG = "it"  # default language


def tr(key, **kw):
    text = STRINGS[LANG].get(key) or STRINGS["en"][key]
    return text.format(**kw) if kw else text


def load_language(argv):
    for arg in argv:
        if arg in ("--lang=it", "--lang=en"):
            return arg[-2:]
    try:
        with open(LANG_FILE) as handle:
            saved = handle.read().strip()
    except OSError:
        saved = ""
    return saved if saved in STRINGS else "it"


def save_language(lang):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(LANG_FILE, "w") as handle:
            handle.write(lang)
    except OSError:
        pass


# ------------------------------------------------------------------- UI ---

PAGE_WIFI, PAGE_COURSES, PAGE_INSTALL, PAGE_DONE = range(4)


class Page(QtWidgets.QWizardPage):
    """Wizard page whose texts are redrawn when the language changes.
    Dynamic messages are stored as (key, values), so they translate too."""

    def __init__(self):
        super().__init__()
        self._dynamic = {}

    def show_text(self, label, key, **kw):
        self._dynamic[label] = (key, kw)
        label.setText(tr(key, **kw))

    def clear_text(self, label):
        self._dynamic.pop(label, None)
        label.setText("")

    def retranslate(self):
        for label, (key, kw) in self._dynamic.items():
            label.setText(tr(key, **kw))


class WifiPage(Page):
    def __init__(self):
        super().__init__()
        self.user = QtWidgets.QLineEdit()
        self.password = QtWidgets.QLineEdit()
        self.password.setEchoMode(QtWidgets.QLineEdit.Password)
        self.wired = QtWidgets.QCheckBox()
        self.skip = QtWidgets.QCheckBox()
        self.message = QtWidgets.QLabel()
        self.message.setWordWrap(True)
        self.message.setStyleSheet("color: #c0392b;")
        self.user_label = QtWidgets.QLabel()
        self.pass_label = QtWidgets.QLabel()
        form = QtWidgets.QFormLayout()
        form.addRow(self.user_label, self.user)
        form.addRow(self.pass_label, self.password)
        layout = QtWidgets.QVBoxLayout(self)
        layout.addLayout(form)
        layout.addWidget(self.wired)
        layout.addWidget(self.skip)
        layout.addWidget(self.message)
        layout.addStretch(1)
        self.skip.toggled.connect(self._toggle)
        self.retranslate()

    def retranslate(self):
        super().retranslate()
        self.setTitle(tr("wifi_title"))
        self.setSubTitle(tr("wifi_subtitle"))
        self.user_label.setText(tr("wifi_user_label"))
        self.pass_label.setText(tr("wifi_pass_label"))
        self.user.setPlaceholderText(tr("wifi_user_hint"))
        self.wired.setText(tr("wifi_wired"))
        self.skip.setText(tr("wifi_skip"))

    def _toggle(self, skipped):
        for widget in (self.user, self.password, self.wired):
            widget.setEnabled(not skipped)

    def initializePage(self):
        if not os.path.isfile(CA_FILE):
            self.show_text(self.message, "wifi_no_ca")
            self.skip.setChecked(True)

    def validatePage(self):
        if self.skip.isChecked():
            return True
        try:
            username = common.normalize_username(self.user.text())
        except ValueError as exc:
            self.show_text(self.message, "err_user_" + str(exc))
            return False
        if not self.password.text():
            self.show_text(self.message, "err_password")
            return False
        try:
            save_connections(username, self.password.text(), self.wired.isChecked())
        except Exception as exc:  # D-Bus, polkit, missing NetworkManager...
            self.show_text(self.message, "err_save", error=exc)
            return False
        self.password.clear()
        self.clear_text(self.message)
        return True


class CoursesPage(Page):
    def __init__(self):
        super().__init__()
        self.setCommitPage(True)
        self.info = QtWidgets.QLabel()
        self.info.setWordWrap(True)
        self.list = QtWidgets.QListWidget()
        self.courses, problems = common.load_courses()
        for course in self.courses:
            item = QtWidgets.QListWidgetItem()
            item.setFlags(item.flags() | QtCore.Qt.ItemIsUserCheckable)
            item.setCheckState(QtCore.Qt.Unchecked)
            item.setData(QtCore.Qt.UserRole, course.id)
            self.list.addItem(item)
        layout = QtWidgets.QVBoxLayout(self)
        layout.addWidget(self.info)
        layout.addWidget(self.list)
        if problems:
            self.show_text(self.info, "courses_problem", problems="; ".join(problems))
        elif not self.courses:
            self.show_text(self.info, "courses_none")
        self.retranslate()

    def retranslate(self):
        super().retranslate()
        self.setTitle(tr("courses_title"))
        self.setSubTitle(tr("courses_subtitle"))
        for i, course in enumerate(self.courses):
            title, desc = common.localized(course, LANG)
            self.list.item(i).setText(title + (" \u2013 " + desc if desc else ""))

    def initializePage(self):
        if self.list.count() and not has_internet():
            self.show_text(self.info, "courses_offline")

    def selected(self):
        return [self.list.item(i).data(QtCore.Qt.UserRole)
                for i in range(self.list.count())
                if self.list.item(i).checkState() == QtCore.Qt.Checked]


class InstallPage(Page):
    def __init__(self):
        super().__init__()
        self._done = False
        self.proc = None
        self.status = QtWidgets.QLabel()
        self.status.setWordWrap(True)
        self.bar = QtWidgets.QProgressBar()
        self.log = QtWidgets.QPlainTextEdit()
        self.log.setReadOnly(True)
        layout = QtWidgets.QVBoxLayout(self)
        layout.addWidget(self.status)
        layout.addWidget(self.bar)
        layout.addWidget(self.log)
        self.retranslate()

    def retranslate(self):
        super().retranslate()
        self.setTitle(tr("install_title"))

    def isComplete(self):
        return self._done

    def _finish(self, key, **kw):
        self.bar.setRange(0, 1)
        self.bar.setValue(1)
        self.show_text(self.status, key, **kw)
        self._done = True
        self.completeChanged.emit()

    def initializePage(self):
        self._done = False
        self.log.clear()
        courses = self.wizard().page(PAGE_COURSES).selected()
        if not courses:
            self._finish("install_nothing")
            return
        self.bar.setRange(0, 0)
        self.show_text(self.status, "installing_dry" if DRY_RUN else "installing")
        self.proc = QtCore.QProcess(self)
        self.proc.setProcessChannelMode(QtCore.QProcess.MergedChannels)
        self.proc.readyRead.connect(self._read)
        self.proc.finished.connect(self._finished)
        self.proc.errorOccurred.connect(self._error)
        self.proc.start("pkexec", [HELPER] + (["--dry-run"] if DRY_RUN else []) + courses)

    def _read(self):
        self.log.appendPlainText(bytes(self.proc.readAll()).decode("utf-8", "replace").rstrip())

    def _finished(self, code, _status):
        if code == 0:
            self._finish("install_ok_dry" if DRY_RUN else "install_ok")
        elif code == 3:
            self._finish("install_untrusted")
        elif code in (126, 127):
            self._finish("install_cancelled")
        else:
            self._finish("install_failed", code=code)

    def _error(self, _err):
        if not self._done:
            self._finish("install_nostart")


class DonePage(Page):
    def __init__(self):
        super().__init__()
        self.setFinalPage(True)
        self.label = QtWidgets.QLabel()
        self.label.setWordWrap(True)
        QtWidgets.QVBoxLayout(self).addWidget(self.label)
        self.retranslate()

    def retranslate(self):
        super().retranslate()
        self.setTitle(tr("done_title"))
        self.label.setText(tr("done_text"))


class Wizard(QtWidgets.QWizard):
    def __init__(self, wifi_available):
        super().__init__()
        self.setWizardStyle(QtWidgets.QWizard.ModernStyle)
        self.setPage(PAGE_WIFI, WifiPage())
        self.setPage(PAGE_COURSES, CoursesPage())
        self.setPage(PAGE_INSTALL, InstallPage())
        self.setPage(PAGE_DONE, DonePage())
        self.setStartId(PAGE_WIFI if wifi_available else PAGE_COURSES)
        # Language switch button, bottom left on every page.
        self.setOption(QtWidgets.QWizard.HaveCustomButton1, True)
        self.setButtonLayout([
            QtWidgets.QWizard.CustomButton1, QtWidgets.QWizard.Stretch,
            QtWidgets.QWizard.BackButton, QtWidgets.QWizard.NextButton,
            QtWidgets.QWizard.CommitButton, QtWidgets.QWizard.FinishButton,
            QtWidgets.QWizard.CancelButton])
        self.customButtonClicked.connect(self._switch_language)
        self.resize(640, 480)
        self.retranslate()

    def _switch_language(self, which):
        global LANG
        if which == QtWidgets.QWizard.CustomButton1:
            LANG = "en" if LANG == "it" else "it"
            save_language(LANG)
            self.retranslate()

    def retranslate(self):
        self.setWindowTitle(tr("window_title"))
        for which, key in ((QtWidgets.QWizard.BackButton, "btn_back"),
                           (QtWidgets.QWizard.NextButton, "btn_next"),
                           (QtWidgets.QWizard.CommitButton, "btn_install"),
                           (QtWidgets.QWizard.FinishButton, "btn_finish"),
                           (QtWidgets.QWizard.CancelButton, "btn_cancel"),
                           (QtWidgets.QWizard.CustomButton1, "btn_lang")):
            self.setButtonText(which, tr(key))
        for page_id in self.pageIds():
            self.page(page_id).retranslate()


def main(argv):
    global LANG
    if "--first-run" in argv and (os.path.exists(DONE_FLAG) or in_live_session()):
        return 0
    LANG = load_language(argv)
    app = QtWidgets.QApplication([argv[0]])
    wizard = Wizard("--force-wifi" in argv or has_wifi_device())
    wizard.exec_()
    mark_done()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
